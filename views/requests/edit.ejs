<%- include("../partials/navbar") %>
<%- include("../partials/flash") %>

<section class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
      <div class="card form-card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">
          <h3 class="fw-bold mb-4">Edit Request</h3>

          <form action="/requests/<%= request._id %>?_method=PUT" method="POST">
            <div class="mb-3">
              <label class="form-label">Food Item</label>
              <input type="text" class="form-control" value="<%= request.donation ? request.donation.foodName : 'N/A' %>" disabled>
            </div>

            <div class="mb-3">
              <label class="form-label">Quantity Requested</label>
              <input type="number" name="quantityRequested" class="form-control" value="<%= request.quantityRequested %>" min="1" required>
            </div>

            <div class="mb-4">
              <label class="form-label">Message</label>
              <textarea name="message" class="form-control" rows="3"><%= request.message %></textarea>
            </div>

            <button type="submit" class="btn btn-warning w-100 fw-semibold py-2">Update Request</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include("../partials/footer") %>
