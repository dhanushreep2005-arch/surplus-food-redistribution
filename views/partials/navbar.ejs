<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SurplusFood | Surplus Food Redistribution System</title>

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark app-navbar sticky-top">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">
      <i class="bi bi-basket2-fill me-1"></i>Surplus<span class="text-warning">Food</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
        <li class="nav-item"><a class="nav-link" href="/">Home</a></li>

        <% if (currentUser) { %>
          <% if (currentUser.role === "donor") { %>
            <li class="nav-item"><a class="nav-link" href="/donations/new">Donate Food</a></li>
            <li class="nav-item"><a class="nav-link" href="/donor/dashboard">My Donations</a></li>
            <li class="nav-item"><a class="nav-link" href="/donor/profile">Profile</a></li>
          <% } else if (currentUser.role === "ngo") { %>
            <li class="nav-item"><a class="nav-link" href="/donations">Available Food</a></li>
            <li class="nav-item"><a class="nav-link" href="/requests">My Requests</a></li>
            <li class="nav-item"><a class="nav-link" href="/ngo/dashboard">Dashboard</a></li>
            <li class="nav-item"><a class="nav-link" href="/ngo/profile">Profile</a></li>
          <% } else if (currentUser.role === "volunteer") { %>
            <li class="nav-item"><a class="nav-link" href="/pickups">Pickups</a></li>
            <li class="nav-item"><a class="nav-link" href="/volunteer/dashboard">Dashboard</a></li>
            <li class="nav-item"><a class="nav-link" href="/volunteer/profile">Profile</a></li>
          <% } %>
          <li class="nav-item">
            <span class="nav-link text-warning-emphasis">Hi, <%= currentUser.name.split(" ")[0] %></span>
          </li>
          <li class="nav-item">
            <a class="btn btn-sm btn-warning fw-semibold px-3" href="/logout">Logout</a>
          </li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
          <li class="nav-item">
            <a class="btn btn-sm btn-warning fw-semibold px-3" href="/register">Register</a>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
