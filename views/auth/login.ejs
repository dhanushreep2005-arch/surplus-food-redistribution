<%- include("../partials/navbar") %>
<%- include("../partials/flash") %>

<section class="auth-section py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        <div class="card auth-card shadow border-0">
          <div class="card-body p-4 p-md-5">
            <h3 class="fw-bold text-center mb-4">Welcome Back</h3>

            <form action="/login" method="POST">
              <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control" placeholder="you@example.com" required>
              </div>

              <div class="mb-4">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" placeholder="Your password" required>
              </div>

              <button type="submit" class="btn btn-warning w-100 fw-semibold py-2">Login</button>
            </form>

            <p class="text-center mt-4 mb-0">
              Don't have an account? <a href="/register" class="fw-semibold">Register here</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include("../partials/footer") %>
